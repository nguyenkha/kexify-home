---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign slugs = "/,/faq/,/about/" | split: "," -%}
{%- for slug in slugs -%}
{%- for l in site.data.languages %}
  <url>
    <loc>{{ l.prefix | append: slug | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
{%- for a in site.data.languages %}
    <xhtml:link rel="alternate" hreflang="{{ a.code }}" href="{{ a.prefix | append: slug | absolute_url }}"/>
{%- endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ slug | absolute_url }}"/>
  </url>
{%- endfor -%}
{%- endfor %}
</urlset>
